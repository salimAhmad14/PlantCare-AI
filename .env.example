# Local secrets. NEVER commit this file - .gitignore covers it.
# Rotate these keys if they have ever been pasted anywhere shared.

PLANTCARE_SECRET_KEY=replace-me-with-a-random-64-char-hex-string

# Free key from https://console.groq.com  (no card required)
GROQ_API_KEY=

# Optional. https://huggingface.co/settings/tokens - a Read token.
# Without it the embedding model still downloads, just rate-limited.
HF_TOKEN=

# Leave empty for no CORS headers. Set to your frontend origin if you add one.
PLANTCARE_CORS_ORIGIN=

# auto | numpy | milvus
# numpy (default, hybrid) | milvus | auto
PLANTCARE_KB_BACKEND=numpy

# Set to 0 to disable the written advisory and use extractive passages only.
PLANTCARE_LLM=1

# Set only when running the Milvus server profile
# PLANTCARE_MILVUS_URI=http://milvus:19530
